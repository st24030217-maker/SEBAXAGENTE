# ============================================================
#  AGENTE SEBAX — variables de entorno
#  Copia este archivo como .env y completa lo que vayas a usar.
#  Todo lo que dejes vacío simplemente queda desactivado.
# ============================================================

# --- Servidor ---
PORT=3000
# URL pública donde corre el servidor (necesaria para webhooks y links de pago)
PUBLIC_URL=http://localhost:3000
# Contraseña del panel de administración (/admin). ¡Cámbiala!
ADMIN_TOKEN=cambia-esta-clave

# --- Claude (obligatorio) ---
ANTHROPIC_API_KEY=
AGENTE_MODELO=claude-opus-5-5
# low | medium | high  (low = respuestas rápidas y baratas, ideal para chat)
AGENTE_ESFUERZO=low
# Reintento automático en otro modelo si Claude rechaza un mensaje (true/false)
AGENTE_FALLBACK=true

# --- WhatsApp Business (Meta Cloud API) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=elige-un-texto-secreto
# Plantilla aprobada para escribir fuera de la ventana de 24 h (seguimientos)
WHATSAPP_FOLLOWUP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=es

# --- Facebook Messenger / Instagram DM (Meta Graph API) ---
META_PAGE_TOKEN=
META_VERIFY_TOKEN=elige-un-texto-secreto
# Secreto de la app de Meta: valida que los webhooks vengan de Meta (WhatsApp y Messenger/IG)
META_APP_SECRET=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# polling = funciona sin URL pública (ideal para probar) | webhook = producción
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=elige-un-texto-secreto

# --- Pagos ---
# manual | mercadopago | stripe
PAYMENT_PROVIDER=manual
MERCADOPAGO_ACCESS_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Avisos al dueño del negocio ---
# Chat de Telegram donde te llegan avisos (leads, pedidos, pagos, derivaciones)
OWNER_TELEGRAM_CHAT_ID=
# Webhook genérico (Slack, Make, Zapier, n8n...). Recibe un POST JSON por evento.
OWNER_WEBHOOK_URL=

# --- Prospección (el agente busca clientes por ti) ---
# Token gratis del INEGI: https://www.inegi.org.mx/app/desarrolladores/generatoken/Usuarios/token_Verify
DENUE_TOKEN=
# Opcional: key de Google solo para subir el límite de PageSpeed (sin key también funciona)
PAGESPEED_API_KEY=
# Modelo para redactar los correos (si no hay ANTHROPIC_API_KEY se usan plantillas)
PROSPECCION_MODELO=claude-opus-5-5
# Correo de envío. Para Gmail: SMTP_PASS es una "contraseña de aplicación" (myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=

# --- IA alternativa: Gemini (Google, plan gratis) ---
# Clave sin tarjeta en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.5-flash
# auto = Claude si tiene saldo, si no Gemini | claude | gemini
IA_PROVEEDOR=auto
# Correo donde te llegan los avisos (si se deja vacío, a SMTP_USER)
OWNER_EMAIL=

# --- WhatsApp con chip aparte ---
# Número del chip (10 dígitos). Sirve para vincularlo con código en vez de QR.
WA_NUMERO=
# false = no conectar WhatsApp
WHATSAPP_CHIP=true
