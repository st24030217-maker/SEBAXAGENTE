            "index": 0
          },
          {
            "node": "Avisar por Gmail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Santiago",
    "saveManualExecutions": true
  },
